# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas connection string)
MONGODB_URI="mongodb://127.0.0.1:27017/jobupdate"

# Authentication & Security
# Secret key used to sign and verify JSON Web Tokens (JWT) for admin session
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Administrator Credentials (initial setup)
# Used for seeding the private administrator account
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@jobupdate.com"
ADMIN_PASSWORD="admin_secret_password"

